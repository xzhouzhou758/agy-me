# /opt/agy-me/agy-me.env (chmod 600)
# Login password hash: docker run --rm -i ghcr.io/xzhouzhou758/agy-me:latest node src/passwd.ts
APP_PASSWORD_HASH=

# Backend 1: CLIProxyAPI (optional if AGM or AI Studio is configured)
CPA_URL=http://127.0.0.1:8318
CPA_MANAGEMENT_KEY=

# Backend 2: lbjlaq/Antigravity-Manager (optional)
AGM_URL=
AGM_API_KEY=
AGM_ADMIN_PASSWORD=

# Backend 3: Mag1cFall/AIStudio2API self-use (optional)
AISTUDIO2_URL=
AISTUDIO2_KEY=
AISTUDIO2_ADMIN_USER=admin
AISTUDIO2_ADMIN_PASSWORD=
# exclusive (single-tenant default, auto-claims existing accounts) | shared (multi-tenant isolation)
AISTUDIO2_MODE=exclusive
AISTUDIO2_RECHECK_MINUTES=60

USAGE_RETENTION_DAYS=30
QUOTA_REFRESH_MINUTES=15
QUOTA_CONCURRENCY=4
UPSTREAM_TIMEOUT_MS=300000
MAX_BODY_MB=20

# Optional remote browser assistant
BROWSERD_URL=http://127.0.0.1:8331
BROWSERD_TOKEN=
BROWSER_UPSTREAM=http://127.0.0.1:3011
BROWSER_IDLE_MINUTES=30
