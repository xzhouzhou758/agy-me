# /opt/agy-me/agy-me.env  (chmod 600)
# Login password hash: docker run --rm -i agy-me:local node src/passwd.ts  (type the password, Enter, Ctrl-D)
APP_PASSWORD_HASH=
# CLIProxyAPI management API (the cpa service in docker-compose.yml). Key = the plain management.secret-key
# written into /opt/agy-me/cpa/config.yaml before CPA's first start
CPA_URL=http://127.0.0.1:8318
CPA_MANAGEMENT_KEY=
# Request log kept in data/usage.sqlite (drained from CPA's usage queue), days
USAGE_RETENTION_DAYS=30
# Background quota refresh (minutes, 0 = off; can be changed on the settings page) and parallel accounts
QUOTA_REFRESH_MINUTES=15
QUOTA_CONCURRENCY=4
# Remote browser: agy-me's OWN browserd (ops/browserd.env.example), never the portal's 8330 / 3010
BROWSERD_URL=http://127.0.0.1:8331
BROWSERD_TOKEN=
BROWSER_UPSTREAM=http://127.0.0.1:3011
BROWSER_IDLE_MINUTES=30
