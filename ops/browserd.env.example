# /opt/agy-me/browserd.env (chmod 600). agy-me's own instance: never the portal's port / container / subnet.
BROWSERD_PORT=8331
BROWSERD_TOKEN=
BROWSER_SUBFOLDER=/me/browser/
BROWSER_NAME=agy-me-browser
BROWSER_NET=agy-me-browser-net
BROWSER_SUBNET=172.31.251.0/24
BROWSER_HOST_PORT=3011
BROWSER_TITLE=agy-me
