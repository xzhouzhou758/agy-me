{
  "name": "agy-me",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Single-user multi-backend gateway & panel for CLIProxyAPI, Antigravity-Manager, and AI Studio",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
